# Supabase credentials (Project Settings -> API)
# Set these as Environment Variables in your Vercel project as well.
NEXT_PUBLIC_SUPABASE_URL=

# Newer publishable key (sb_publishable_...). Safe to expose in the browser.
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
